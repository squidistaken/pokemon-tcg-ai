# Template for the untracked .env in the repo root:  cp .env.example .env

# Weights & Biases API key, from https://wandb.ai/authorize
# W&B is the default backend. Online runs require this key or a verified
# `wandb login`; use `wandb.mode=offline` deliberately or `callbacks=none` to opt out.
WANDB_API_KEY=

# Kaggle CLI access token from https://www.kaggle.com/settings/api.
# The CLI also supports `kaggle auth login` and token files, so this can stay
# empty when authentication is already configured outside the repository.
KAGGLE_API_TOKEN=
KAGGLE_COMPETITION=pokemon-tcg-ai-battle

# Local defaults consumed by scripts/make_submission.py.
CHECKPOINTS_DIR=outputs
CHECKPOINT_KEYS_FILE=logs/checkpoint_keys.csv
KAGGLE_SUBMISSIONS_DIR=submissions
# KAGGLE_DECK_PATH=decks/example.csv
# KAGGLE_DEFAULT_MESSAGE=
